{
  "uid": "llm-evaluations",
  "title": "LLM Evaluations",
  "tags": ["ventures", "rag", "ragas"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queries over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres_ventures" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "points", "pointSize": 6, "lineWidth": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS \"time\", 1 AS \"queries\" FROM llm_evaluations ORDER BY created_at"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Likes vs dislikes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres_ventures" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(liked_disliked, 'NONE') AS feedback, count(*) AS count FROM llm_evaluations GROUP BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Faithfulness over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres_ventures" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS \"time\", faithfulness AS \"faithfulness\" FROM llm_evaluations WHERE faithfulness IS NOT NULL ORDER BY created_at"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Answer relevance over time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres_ventures" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS \"time\", answer_relevancy AS \"answer_relevancy\" FROM llm_evaluations WHERE answer_relevancy IS NOT NULL ORDER BY created_at"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Queries by room",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres_ventures" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(room, 'general') AS room, count(*) AS queries FROM llm_evaluations GROUP BY 1 ORDER BY 2 DESC"
        }
      ]
    }
  ]
}
